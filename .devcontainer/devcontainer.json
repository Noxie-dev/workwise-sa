{
  "name": "WorkWise Development Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "forwardPorts": [3001, 5173, 8080, 5001, 5050, 9099, 9199, 9000],
  "portsAttributes": {
    "3001": {
      "label": "Backend API Server",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Firestore Emulator",
      "onAutoForward": "notify"
    },
    "5001": {
      "label": "Firebase Functions Emulator",
      "onAutoForward": "notify"
    },
    "5050": {
      "label": "Firebase Hosting Emulator",
      "onAutoForward": "notify"
    },
    "9099": {
      "label": "Firebase Auth Emulator",
      "onAutoForward": "notify"
    },
    "9199": {
      "label": "Firebase Storage Emulator",
      "onAutoForward": "notify"
    },
    "9000": {
      "label": "Firebase Database Emulator",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install --no-audit --no-fund && npm --prefix client install --no-audit --no-fund && npm --prefix server install --no-audit --no-fund && npm --prefix functions install --no-audit --no-fund",
  "remoteUser": "node",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace"
}
