{
  "name": "workwise-sa",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "check:emulators": "node scripts/check-emulators.js",
    "check:firebase-config": "node scripts/check-firebase-config.js",
    "copy-assets:unix": "mkdir -p client/public/images && cp -r public/images/* client/public/images/ && cp public/*.png public/*.ico public/*.svg public/site.webmanifest client/public/",
    "copy-assets:win": "if not exist client\\public\\images mkdir client\\public\\images && xcopy /E /Y public\\images client\\public\\images\\ && copy /Y public\\*.png public\\*.ico public\\*.svg public\\site.webmanifest client\\public\\",
    "copy-assets": "node -e \"process.platform === 'win32' ? process.exit(require('child_process').spawnSync('pnpm', ['run', 'copy-assets:win'], {stdio:'inherit'}).status) : process.exit(require('child_process').spawnSync('pnpm', ['run', 'copy-assets:unix'], {stdio:'inherit'}).status)\"",
    "dev:client": "kill-port 5173 && vite --host 0.0.0.0 --force",
    "dev:server": "kill-port 3001 && tsx --watch server/server/index.ts",
    "worker:squarejump": "tsx server/workers/squareJumpReleaseWorker.ts",
    "worker:squarejump:matches": "tsx server/workers/squareJumpMatchMaterializationWorker.ts",
    "worker:squarejump:links": "tsx server/workers/squareJumpLinkVerificationWorker.ts",
    "dev:original": "pnpm run copy-assets && concurrently --kill-others-on-fail \"pnpm run dev:server\" \"node -e \\\"setTimeout(() => require('child_process').spawn('pnpm', ['run', 'dev:client'], {stdio:'inherit'}), 2000)\\\"\"",
    "dev": "pnpm run copy-assets && concurrently --kill-others-on-fail \"pnpm run dev:server\" \"node -e \\\"setTimeout(() => require('child_process').spawn('pnpm', ['run', 'dev:client'], {stdio:'inherit'}), 2000)\\\"\"",
    "dev:with-checks": "pnpm run copy-assets && pnpm run check:emulators && concurrently --kill-others-on-fail \"pnpm run dev:server\" \"node -e \\\"setTimeout(() => require('child_process').spawn('pnpm', ['run', 'dev:client'], {stdio:'inherit'}), 2000)\\\"\"",
    "build:client": "vite build",
    "build:server": "esbuild server/server/index.ts --platform=node --bundle --format=esm --outfile=dist/index.js --packages=external --target=es2022",
    "build": "node scripts/optimize-build.js && pnpm run copy-assets && pnpm run build:client && pnpm run build:server",
    "build:analyze": "vite build --mode analyze",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:source": "cross-env NODE_ENV=production tsx server/server/index.ts",
    "check": "node scripts/check-root.js",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:migrate:test": "cross-env NODE_ENV=test tsx scripts/run-migrations.ts",
    "db:generate": "tsx scripts/generate-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "db:status": "tsx scripts/migration-status.ts",
    "create:test-users": "tsx scripts/create-test-users.js",
    "test:auth-persistence": "tsx scripts/test-auth-persistence.js",
    "test:email-link": "tsx scripts/test-email-link-auth.js",
    "test": "vitest",
    "test:client": "vitest run --config client/vitest.config.ts",
    "test:client:coverage": "vitest run --config client/vitest.config.ts --coverage",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:server": "vitest run server/tests/unit",
    "test:server:coverage": "vitest run server/tests/unit --coverage",
    "test:integration": "vitest run server/tests/unit",
    "test:unit": "vitest run server/tests/unit",
    "test:api": "vitest run server/tests/unit/jobIngestRoutes.test.ts",
    "test:performance": "tsx tests/performance/api-performance.ts",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright test tests/e2e/jobs-auth-gate.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test tests/visual/*.spec.ts",
    "test:a11y": "vitest run --config client/vitest.config.ts src/lib/accessibilityPreferences.test.ts src/components/accessibility/AccessibilitySettingsModal.test.tsx",
    "test:smoke:staging": "playwright test tests/smoke/ --config=playwright.staging.config.ts",
    "test:smoke:production": "playwright test tests/smoke/ --config=playwright.production.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "lighthouse": "lhci autorun",
    "security:audit": "npm audit",
    "security:tracked-secrets": "node scripts/check-tracked-secrets.js",
    "security:rotate-session-secret": "node scripts/rotate-session-secret.js",
    "check:upload-volume": "node scripts/check-upload-volume.js",
    "security:fix": "npm audit fix",
    "netlify:dev": "netlify dev",
    "netlify:build": "pnpm run copy-assets && pnpm run build:client:optimized && pnpm run netlify:post-build",
    "build:client:optimized": "vite build --mode production --minify terser",
    "netlify:prepare": "node scripts/prepare-netlify-deploy.js",
    "netlify:validate": "node scripts/validate-netlify-config.js",
    "netlify:test": "node scripts/test-deployment.js",
    "netlify:security": "node scripts/validate-security.js",
    "firebase:validate": "node scripts/validate-firebase.js",
    "deploy:fast": "node scripts/fast-deploy.js",
    "netlify:post-build": "node scripts/netlify-post-build.js",
    "deploy:prod": "pnpm run build && pnpm run env:check-prod && node scripts/validate-primary-runtime.js",
    "deploy:legacy:netlify": "pnpm run build && netlify deploy --prod",
    "deploy:legacy:netlify:fast": "node scripts/fast-deploy.js",
    "deploy:legacy:firebase:hosting": "firebase deploy --only hosting",
    "deploy:legacy:firebase:functions": "firebase deploy --only functions",
    "deploy:legacy:firebase:all": "firebase deploy",
    "firebase:build": "pnpm run build",
    "firebase:deploy": "firebase deploy --only hosting",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:all": "firebase deploy",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "deploy:firebase": "node scripts/firebase-deploy.js",
    "deploy:firebase:all": "node scripts/firebase-deploy.js all",
    "deploy:firebase:functions": "node scripts/firebase-deploy.js functions",
    "firebase:serve": "firebase serve --only hosting",
    "firebase:emulators": "firebase emulators:start",
    "dataconnect:sdk:generate": "firebase dataconnect:sdk:generate",
    "dataconnect:sdk:patch-peers": "node scripts/patch-dataconnect-sdk-peers.js",
    "dataconnect:sdk:regenerate": "npm run dataconnect:sdk:generate && npm run dataconnect:sdk:patch-peers",
    "env:sanitize": "node scripts/sanitize-env.js",
    "env:check": "node -e \"import('fs').then(fs => { if(fs.existsSync('.env') && fs.existsSync('client/.env')) { console.log('✅ Environment files exist'); process.exit(0); } else { console.error('❌ Missing .env files. Run: cp .env.example .env && cp .env.example client/.env'); process.exit(1); } })\"",
    "env:setup-prod": "node scripts/setup-production-env.js set",
    "env:check-prod": "node scripts/setup-production-env.js check",
    "env:setup:primary": "node scripts/setup-production-env.js set",
    "env:check:primary": "node scripts/setup-production-env.js check",
    "env:verify:supported": "node scripts/verify-supported-environments.js",
    "env:verify:primary": "node scripts/verify-supported-environments.js primary",
    "env:verify:local": "node scripts/verify-supported-environments.js local",
    "setup:ssh": "./scripts/setup-github-ssh.sh",
    "verify:ssh": "./scripts/verify-ssh-github.sh",
    "qa:all": "pnpm run lint && pnpm run type-check && pnpm run test:coverage && pnpm run test:e2e",
    "qa:quick": "pnpm run lint && pnpm run type-check && pnpm run test",
    "precommit": "pnpm run qa:quick"
  },
