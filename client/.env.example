# WARNING: This is an example environment file.
# DO NOT add real API keys or secrets to this file.
# Create a copy named .env and add your actual values there.
#
# This file should be committed to version control.
# The actual .env files should NEVER be committed.

# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=workwise-sa-project
VITE_FIREBASE_AUTH_DOMAIN=workwise-sa-project.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=workwise-sa-project.appspot.com
# Use real values from the Firebase console for production.
# These placeholders allow the app to boot in local demo/emulator mode.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Email Link Authentication Configuration
# VITE_FIREBASE_DYNAMIC_LINK_DOMAIN=your-dynamic-link-domain.page.link
# VITE_IOS_BUNDLE_ID=com.workwisesa.app
# VITE_ANDROID_PACKAGE_NAME=com.workwisesa.app

# Firebase Emulator Configuration
VITE_USE_FIREBASE_EMULATORS=true

# Public UI data (home/jobs) mock mode for local development.
# Set to false to hit live local APIs/Netlify functions instead.
VITE_USE_MOCK_PUBLIC_DATA=true

# AI Integration Keys
VITE_GOOGLE_GENAI_API_KEY=your_vite_google_genai_api_key_here

# API Configuration
VITE_API_URL=http://localhost:5000
